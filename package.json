{
  "name": "macintosh.js",
  "productName": "macintosh.js",
  "version": "1.2.0",
  "description": "Macintosh's System 8 in a Tauri app.",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && tauri build",
    "build:renderer": "vite build",
    "package": "tauri build --no-bundle",
    "make": "tauri build",
    "publish": "tauri build",
    "lint": "prettier --check \"src/renderer/**/*.{js,css}\" \"src/basilisk/*.{js,mjs}\" --ignore-path .prettierignore && npm run check-links",
    "fix": "prettier --write \"src/renderer/**/*.{js,css}\" \"src/basilisk/*.{js,mjs}\" --ignore-path .prettierignore",
    "check-links": "node tools/check-links.js",
    "tauri": "tauri"
  },
  "keywords": [],
  "author": {
    "name": "Felix Rieseberg",
    "email": "felix@felixrieseberg.com"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.19.17",
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  }
}
