{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the emulator window and its help/credits pages",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main", "child-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "allow-app-info",
    "allow-get-shared-path",
    "allow-boot-disk-info",
    "allow-is-dev-mode",
    "allow-set-dev-mode",
    "allow-reveal-shared-dir",
    "allow-open-license",
    "allow-show-error",
    "allow-toggle-devtools",
    "allow-quit",
    "allow-register-disks",
    "allow-disk-open",
    "allow-disk-close",
    "allow-disk-size",
    "allow-disk-read",
    "allow-disk-write",
    "allow-ethernet-init",
    "allow-ethernet-send",
    "allow-list-user-images",
    "allow-read-shared-tree",
    "allow-write-shared-file"
  ]
}
